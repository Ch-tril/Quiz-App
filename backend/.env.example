# ======================================
# Environment Variables - Copy to .env
# ======================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_DEV_URL=http://localhost:5500

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/quiz-app
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quiz-app

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Admin Panel
ADMIN_SECRET=admin_secret_key_change_this

# Email Configuration (Optional - for future features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# Session
SESSION_SECRET=session_secret_key_change_this

# API Documentation
API_DOCS_ENABLED=true
